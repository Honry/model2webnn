 "chain": {
  "description": "HEAD = attention half of layer 0 + the per-layer-embedding prologue (outputs ple_0 .. ple_{N-1}); BLOCK i (i = 0 .. N-2) = feed-forward half of layer i (input per_layer_input = ple_i) + attention half of layer i + 1, the graph of its KIND (plan.graphs[..].blocks[kind]); TAIL = feed-forward half of layer N-1 + final norm; lm_head (with the logit softcap). The kind of layer i is model.json layer_types[i] + '_own' | '_shared' (kv_producer[i] >= 0 = it attends over the cache of that layer).",
  "num_layers": 6,
  "kinds": [
   "sliding_attention_own",
   "sliding_attention_own",
   "full_attention_own",
   "sliding_attention_own",
   "full_attention_shared",
   "sliding_attention_shared"
  ],
  "block_groups": {
   "description": "decode only: graphs.<variant>.decode.<max length>.block_groups[K] = the N - 1 BLOCKs cut into runs of K ([{first_block, blocks, key, graph}], the last run may be shorter), one graph per distinct sequence of kinds (key: the kinds joined by '-', so / fo = sliding / full attention with K / V of its own, ss / fs = sliding / full attention sharing K / V). A group graph takes residual + attention_output of its first block and returns next_residual + next_attention_output of its last block. Block j (BLOCK first_block + j) has the prefix b<j>_: b<j>_per_layer_input (ple_<first_block + j>), the weights of the feed-forward half of layer first_block + j and of the attention half of layer first_block + j + 1, and b<j>_past_key / b<j>_past_value / b<j>_staging_key / b<j>_staging_value = the main cache and staging buffer of the layer whose K / V that attention half reads (model.json kv_producer); a block that reads the cache of a layer already read by an earlier block of the group has no cache inputs (it reuses that block's), and a block that reads the cache of a layer INSIDE the group attends over the staging buffer after that layer's update, computed in the graph. Output b<j>_updated_key / b<j>_updated_value (blocks with K / V of their own) = the spare staging buffer, to be swapped in. <layer type>_rope_cos / _rope_sin / _attention_mask: one per layer type (the decode masks of own and shared layers are the same). Prefill has no groups (prefill_blocks_per_graph = [1]).",
   "kind_codes": {
    "so": "sliding_attention_own",
    "fo": "full_attention_own",
    "ss": "sliding_attention_shared",
    "fs": "full_attention_shared"
   }
  }
 },
 "per_layer_type_inputs": {
  "description": "rope_cos / rope_sin [1,1,S,head_dim of the type] / attention_mask of an attention half are bound with the tables of the layer type of ITS layer; a shared layer's mask has the columns of the cache it reads (prefill: P, decode: P + staging rows)",
  "inputs": [
   "rope_cos",
   "rope_sin",
   "attention_mask"
  ]
 },
 "kv_protocols": {
  "description": "only the staged protocol: prefill = chunks (the last one left-padded) updating the main caches of the layers with K / V of their own; decode = the new row goes into a staging buffer, attention reads concat(main cache, staging), the flush graph (one per layer type) moves the staging rows into the main cache every staging_rows steps. Layers that share K / V read the cache of their producer: decode = its main cache + its staging buffer after this step's update; prefill = its cache after the update of the chunk."
 },
 "host": {
  "embed_scale": 11.313708498984761,
  "ple": "per prompt token a row of the ple_table (int8 * row scale, float16) is bound to HEAD's ple_token input; the graph scales it by sqrt(ple_dim)",
  "logit_softcap": 30.0
 },
 "prefill_planning": "several chunk sizes: protocol plan_prefill() picks the chunk sequence of a prompt with the lowest sum of (fixed tokens + size); fixed tokens default 200",
 "logits": {
  "padded_vocab": 384,
  "vocab": 300,
  "note": "argmax / sampling over the first `vocab` entries only"
 }
