 "chain": {
  "description": "HEAD = attention half of layer 0; BLOCK i (i = 0 .. N-2) = feed-forward half of layer i + attention half of layer i+1; TAIL = feed-forward half of layer N-1 + final norm; lm_head. Per layer the runtime binds the weights of the 'attention_weights' layer and the 'ffn_weights' layer from the weights manifest.",
  "num_layers": 3,
  "head": {
   "attention_layer": 0
  },
  "block": {
   "ffn_layer": "i",
   "attention_layer": "i+1"
  },
  "tail": {
   "ffn_layer": "N-1"
  }
 },
 "per_layer_type_inputs": {
  "description": "rope_cos / rope_sin / attention_mask of an attention half are bound with the tables of the layer type of ITS layer (see model.json: layer_types, rope, sliding_window)",
  "inputs": [
   "rope_cos",
   "rope_sin",
   "attention_mask"
  ]
 },
 "kv_protocols": {
  "description": "how the KV cache is written and attended, by the kv_style of a variant (cache rows P = max_length - 1; row j holds position j; protocol.py / protocol.ts)",
  "staged": "prefill: chunks of the chunk size, the last chunk is left-padded, one-hot row selectors write the real rows; decode: the new row goes into a staging buffer (staging_rows rows), attention reads concat(main cache, staging), the flush graph moves the staging rows into the main cache every staging_rows steps",
  "onehot": "prefill as staged; decode: the graph writes the new row into the main cache with one-hot selectors (rows_to_keep / row_selector), attention reads concat(cache, new row)",
  "scatterND": "prefill and decode: scatterND(cache, kv_indices, new rows) with the (0, head, cache row) of every new row, attention reads the updated cache; the pad rows of the left-padded last chunk are parked behind the real rows",
  "tensorScatter": "prefill and decode: tensorScatter(cache, new rows, kv_write_index, axis 2), attention reads the updated cache; every chunk is full, the prompt padding is in FRONT of the prompt (cache rows 0..pad-1)"
 },
 "prefill_planning": "several chunk sizes: protocol plan_prefill() picks the chunk sequence of a prompt with the lowest sum of (fixed tokens + size); fixed tokens default 200",
 "logits": {
  "padded_vocab": 384,
  "vocab": 300,
  "note": "argmax / sampling over the first `vocab` entries only"
 },
 "recommended": {
  "blocks_per_graph": 1,
  "prefill_blocks_per_graph": 1
 }
}